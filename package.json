{
    "name": "@quatico/magellan",
    "description": "Compiler and runtime API for remote execution of service functions written in TypeScript.",
    "version": "0.16.0-SNAPSHOT.0",
    "keywords": [
        "typescript",
        "java",
        "compiler",
        "addons"
    ],
    "private": true,
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "files": [
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "clean": "pnpm run --recursive clean",
        "lint": "pnpm run --recursive lint",
        "lint:fix": "pnpm run --recursive lint",
        "build": "pnpm run --recursive build",
        "typecheck": "pnpm run --recursive typecheck",
        "test": "pnpm run --recursive test",
        "test:update": "pnpm run --recursive test:update",
        "test:e2e": "pnpm run --recursive test:e2e",
        "dist": "pnpm run --recursive dist && pnpm run --recursive test:e2e",
        "watch": "pnpm run --recursive watch",
        "watch:test": "pnpm run --recursive --parallel watch:test",
        "publish-npm": "pnpm run --recursive publish-npm",
        "license:check": "license-check-and-add check -f license-config.json",
        "license:add": "license-check-and-add add -f license-config.json",
        "license:remove": "license-check-and-add remove -f license-config.json"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^9.39.5",
        "@types/node": "24",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "@typescript-eslint/utils": "^8.70.1",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.16.6",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-testing-library": "^7.16.2",
        "eslint-plugin-unicorn": "^65.0.1",
        "jest": "^30.5.2",
        "license-check-and-add": "^4.0.5",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.8",
        "regenerator-runtime": "0.14.1",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "typescript": "5.7.3",
        "typescript-eslint": "^8.70.1"
    }
}
