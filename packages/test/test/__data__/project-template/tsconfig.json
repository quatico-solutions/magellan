{
    "compilerOptions": {
        "target": "ES2019",
        "module": "CommonJS",
        "lib": ["ES2015", "DOM"],
        "types": ["node"],
        "allowJs": true,
        "declaration": true,
        "declarationMap": true,
        "outDir": "./lib",
        "noEmit": false,
        "importHelpers": true,
        "downlevelIteration": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "inlineSources": true,
        "sourceMap": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "noEmitOnError": true,
        "skipLibCheck": true,
        "moduleResolution": "node"
    },
    "exclude": ["node_modules", "src/**/*.spec.tsx", "src/**/*.spec.ts"],
    "include": ["src"]
}
