{
    "name": "@quatico/magellan-addons",
    "version": "1.0.0-SNAPSHOT.0",
    "description": "A example library for the websmith compiler",
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/quatico-solutions/magellan"
    },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "lib"
    ],
    "scripts": {
        "clean": "rimraf lib dist bin coverage output.yaml",
        "lint": "eslint \"{src,test}/**/*.ts\" --color && pnpm typecheck",
        "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
        "build": "tsc",
        "typecheck": "tsc --project tsconfig.test.json",
        "dist": "cross-env-shell NODE_ENV=production \"pnpm clean && pnpm lint && pnpm test && pnpm build\"",
        "test": "jest --testRegex=\"src/.*\\.spec\\.ts$\" --coverage",
        "test:update-snapshots": "pnpm test -u",
        "watch": "tsc --watch",
        "watch:test": "jest --testRegex=\"src/.*\\.spec\\.ts$\" --color --watch",
        "publish-npm": "pnpm publish --access public --no-git-checks --publish-branch develop"
    },
    "dependencies": {
        "tslib": "^2.8.1"
    },
    "peerDependencies": {
        "@quatico/magellan-client": "workspace:*",
        "@quatico/magellan-server": "workspace:*",
        "@quatico/websmith-api": "0.9.x",
        "@quatico/websmith-core": "0.9.x",
        "typescript": ">=5"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^9.39.5",
        "@quatico/magellan-client": "workspace:*",
        "@quatico/magellan-server": "workspace:*",
        "@quatico/magellan-shared": "workspace:*",
        "@quatico/websmith-api": "0.9.0",
        "@quatico/websmith-compiler": "0.9.0",
        "@quatico/websmith-core": "0.9.0",
        "@quatico/websmith-testing": "0.9.0",
        "@types/jest": "^30.0.0",
        "@types/node": "24",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "@typescript-eslint/utils": "^8.70.1",
        "commander": "^14.0.0",
        "cross-env": "10.1.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.16.6",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-testing-library": "^7.16.2",
        "eslint-plugin-unicorn": "^65.0.1",
        "jest": "^30.5.2",
        "prettier": "^3.9.8",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.4.12",
        "typescript": "5.7.3",
        "typescript-eslint": "^8.70.1"
    }
}
