{
    "name": "@quatico/magellan-client",
    "description": "Client library for proxies generated with @quatico/websmith-compiler",
    "version": "0.19.2",
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/quatico-solutions/magellan"
    },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "lib"
    ],
    "scripts": {
        "clean": "rimraf lib coverage",
        "lint": "eslint \"{src,test}/**/*.ts\" --color && pnpm typecheck",
        "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
        "build": "tsc",
        "typecheck": "tsc --project tsconfig.test.json",
        "dist": "cross-env-shell NODE_ENV=production \"pnpm clean && pnpm lint && pnpm test && pnpm build\"",
        "test": "jest --color --coverage",
        "test:update-snapshots": "pnpm test -u",
        "watch": "tsc --watch",
        "watch:test": "jest --color --watch",
        "publish-npm": "pnpm publish --access public --no-git-checks --publish-branch develop"
    },
    "peerDependencies": {
        "@quatico/magellan-shared": "workspace:*",
        "tslib": "2.x"
    },
    "devDependencies": {
        "@eslint/compat": "^1.2.6",
        "@eslint/js": "^9.19.0",
        "@quatico/magellan-shared": "workspace:*",
        "@types/jest": "^29.5.1",
        "@typescript-eslint/eslint-plugin": "^8.22.0",
        "@typescript-eslint/parser": "^8.22.0",
        "@typescript-eslint/utils": "^8.22.0",
        "cross-env": "^7.0.3",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^3.6.3",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^28.11.0",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-testing-library": "^7.1.1",
        "eslint-plugin-unicorn": "^56.0.1",
        "jest": "^29.5.0",
        "jest-environment-jsdom": "^29.5.0",
        "prettier": "^3.5.3",
        "rimraf": "^5.0.0",
        "ts-jest": "^29.1.0",
        "tslib": "^2.8.1",
        "typescript": "5.1.6",
        "typescript-eslint": "^8.22.0"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    }
}
