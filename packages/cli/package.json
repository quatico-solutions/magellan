{
    "name": "@quatico/magellan-cli",
    "description": "CLI for the Magellan project",
    "version": "0.18.0",
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/quatico-solutions/magellan"
    },
    "bin": {
        "magellan": "bin/magellan.js"
    },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "lib",
        "bin"
    ],
    "scripts": {
        "clean": "rimraf lib bin coverage",
        "lint": "eslint \"{src,test}/**/*.ts\" --color",
        "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix && pnpm typecheck",
        "build": "tsc && pnpm bundle",
        "typecheck": "tsc --project tsconfig.test.json",
        "bundle": "webpack",
        "dist": "cross-env-shell NODE_ENV=production \"pnpm clean && pnpm lint && pnpm test && pnpm build\"",
        "dev:compile": "tsc && node lib/index.js compile ../../../qs-magellan-sandbox/packages/react/src/functions -s ../../../qs-magellan-sandbox/packages/react/server-esm -p ../../../qs-magellan-sandbox/packages/react/tsconfig.json",
        "dev:serve": "tsc && node lib/index.js serve ../../../qs-magellan-sandbox/packages/react/lib -s ../../../qs-magellan-sandbox/packages/react/server-esm",
        "test": "jest --testRegex=\".*\\.spec\\.ts$\" --coverage",
        "test:update-snapshots": "pnpm test -u",
        "test:e2e": "jest --testRegex=\".*\\.test\\.ts$\" --coverage",
        "watch": "tsc --watch",
        "watch:test": "jest --color --watch",
        "publish-npm": "pnpm publish --access public --no-git-checks --publish-branch develop"
    },
    "dependencies": {
        "@quatico/magellan-client": "workspace:*",
        "@quatico/magellan-server": "workspace:*",
        "@quatico/magellan-shared": "workspace:*",
        "@quatico/websmith-api": "0.8.3",
        "@quatico/websmith-compiler": "0.8.3",
        "@quatico/websmith-core": "0.8.3",
        "commander": "^13.1.0",
        "minimist": "1.2.8",
        "tslib": "^2.8.1",
        "typescript": "5.7.3",
        "websmith-loader": "0.8.3"
    },
    "devDependencies": {
        "@eslint/compat": "^1.2.6",
        "@eslint/js": "^9.19.0",
        "@types/jest": "^29.2.2",
        "@types/minimist": "1.2.5",
        "@types/node": "18",
        "@typescript-eslint/eslint-plugin": "^8.22.0",
        "@typescript-eslint/parser": "^8.22.0",
        "@typescript-eslint/utils": "^8.22.0",
        "cross-env": "^7.0.3",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^3.6.3",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^28.11.0",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-testing-library": "^7.1.1",
        "eslint-plugin-unicorn": "^56.0.1",
        "jest": "^29.3.1",
        "prettier": "^3.5.3",
        "rimraf": "^5.0.0",
        "terser-webpack-plugin": "^5.3.10",
        "ts-jest": "^29.0.3",
        "ts-loader": "^9.5.1",
        "typescript": "5.7.3",
        "typescript-eslint": "^8.22.0",
        "webpack": "^5.94.0",
        "webpack-cli": "^5.1.4",
        "webpack-node-externals": "^3.0.0"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    }
}
