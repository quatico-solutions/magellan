{
    "name": "@quatico/magellan-cli",
    "description": "CLI for the Magellan project",
    "version": "0.14.2",
    "author": "Quatico Solutions AG",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "https://github.com/quatico-solutions/magellan"
    },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "bin": {
        "magellan": "./bin/magellan.js"
    },
    "files": [
        "LICENSE",
        "README.md",
        "lib",
        "bin"
    ],
    "scripts": {
        "clean": "rimraf lib bin coverage",
        "lint": "eslint \"{src,test}/**/*.ts\" --color",
        "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
        "build": "tsc && pnpm bundle",
        "bundle": "esbuild src/cli.ts --bundle  --outfile=bin/magellan.js --target=node18 --platform=node --minify --tree-shaking=true --external:typescript",
        "dist": "cross-env-shell NODE_ENV=production \"pnpm clean && pnpm lint && pnpm test && pnpm build\"",
        "dev:compile": "ts-node src/index.ts compile ../../../qs-magellan-sandbox/packages/react/src/functions -s ../../../qs-magellan-sandbox/packages/react/server-esm -p ../../../qs-magellan-sandbox/packages/react/tsconfig.json",
        "dev:serve": "ts-node src/index.ts serve ../../../qs-magellan-sandbox/packages/react/lib -s ../../../qs-magellan-sandbox/packages/react/server-esm",
        "test": "jest --color --coverage",
        "test:update-snapshots": "pnpm test -u",
        "watch": "tsc --watch",
        "watch:test": "jest --color --watch",
        "publish-npm": "pnpm publish --access public --no-git-checks --publish-branch develop"
    },
    "dependencies": {
        "@quatico/magellan-client": "workspace:*",
        "@quatico/magellan-server": "workspace:*",
        "@quatico/magellan-shared": "workspace:*",
        "@quatico/websmith-api": "^0.6.3",
        "@quatico/websmith-compiler": "^0.6.3",
        "@quatico/websmith-core": "^0.6.3",
        "commander": "^12.1.0",
        "minimist": "1.2.8",
        "ts-node": "10.9.x",
        "typescript": "5.0.x"
    },
    "devDependencies": {
        "@eslint/compat": "^1.2.6",
        "@eslint/js": "^9.19.0",
        "@types/jest": "^29.2.2",
        "@types/minimist": "1.2.5",
        "@types/node": "18",
        "@typescript-eslint/eslint-plugin": "^8.22.0",
        "@typescript-eslint/parser": "^8.22.0",
        "@typescript-eslint/utils": "^8.22.0",
        "cross-env": "^7.0.3",
        "esbuild": "^0.24.0",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^3.6.3",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^28.11.0",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-testing-library": "^7.1.1",
        "eslint-plugin-unicorn": "^56.0.1",
        "jest": "^29.3.1",
        "prettier": "^3.5.3",
        "rimraf": "^5.0.0",
        "ts-jest": "^29.0.3",
        "typescript": "5.1.6",
        "typescript-eslint": "^8.22.0"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    }
}
