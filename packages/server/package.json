{
    "name": "@quatico/magellan-server",
    "description": "Middleware for remote service execution with the @quatico/websmith-compiler",
    "version": "0.16.1",
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/quatico-solutions/magellan"
    },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "lib"
    ],
    "scripts": {
        "clean": "rimraf lib coverage",
        "lint": "eslint \"{src,test}/**/*.ts\" --color",
        "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
        "build": "tsc",
        "dist": "cross-env-shell NODE_ENV=production \"pnpm clean && pnpm lint && pnpm test && pnpm build\"",
        "dev": "tsc && node lib/cli/index.js serve ../../../qs-magellan-sandbox/packages/react/lib ../../../qs-magellan-sandbox/packages/react/server-esm",
        "test": "jest --color --coverage",
        "test:update-snapshots": "pnpm test -u",
        "watch": "tsc --watch",
        "watch:test": "jest --color --watch",
        "publish-npm": "pnpm publish --access public --no-git-checks --publish-branch develop"
    },
    "peerDependencies": {
        "@quatico/magellan-shared": "workspace:*",
        "cors": "2.x",
        "express": "5.x",
        "http-errors": "1.x",
        "multer": "1.x",
        "tslib": "2.x"
    },
    "devDependencies": {
        "@eslint/compat": "^1.2.6",
        "@eslint/js": "^9.19.0",
        "@quatico/magellan-shared": "workspace:*",
        "@types/cors": "2.8.13",
        "@types/express": "5.0.1",
        "@types/http-errors": "^2.0.1",
        "@types/jest": "^29.5.1",
        "@types/multer": "1.4.7",
        "@types/node": "18",
        "@types/supertest": "^2.0.12",
        "@typescript-eslint/eslint-plugin": "^8.22.0",
        "@typescript-eslint/parser": "^8.22.0",
        "@typescript-eslint/utils": "^8.22.0",
        "cors": "2.8.x",
        "cross-env": "^7.0.3",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^3.6.3",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^28.11.0",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-testing-library": "^7.1.1",
        "eslint-plugin-unicorn": "^56.0.1",
        "express": "5.1.0",
        "http-errors": "1.6.x",
        "jest": "^29.5.0",
        "memfs": "3.5.x",
        "multer": "1.4.5-lts.1",
        "prettier": "^3.5.3",
        "rimraf": "^5.0.0",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.0",
        "tslib": "^2.8.1",
        "typescript": "5.1.6",
        "typescript-eslint": "^8.22.0"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    }
}
